{
  "name": "push-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.0.0",
    "apns2": "^12.2.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.22.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
