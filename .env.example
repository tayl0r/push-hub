DATABASE_URL=postgres://postgres:postgres@db:5432/pushhub
PORT=3000
GLITCHTIP_DSN=
SENTRY_ENVIRONMENT=development
# JSON array of tenants; keep it on one line in the real .env.
# apiKeyHash = sha256(hex) of the tenant's app key. See README.md for how to generate one.
PUSH_HUB_TENANTS=[]

# Test-only: a Postgres reachable for the store test suite (test/store.test.ts).
# The vitest globalSetup migrates this DB automatically before tests run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5435/pushhub_test
