DATABASE_URL=postgres://postgres:postgres@db:5432/pushhub
PORT=3000

# Internal-only Prometheus metrics port (GET /metrics). Optional; defaults to 9464.
METRICS_PORT=9464
GLITCHTIP_DSN=
SENTRY_ENVIRONMENT=development

# Registration-only key held in the deploy/agent plane (NOT in each app's runtime env).
# Authorizes POST /v1/tenants to claim a new, unclaimed slug — nothing else. Generate with:
#   openssl rand -hex 24
PUSH_HUB_ENROLL_KEY=

# Symmetric key (32 bytes = 64 hex chars) encrypting tenant provider creds at rest (AES-256-GCM).
# MUST be stable per environment forever — changing it makes existing encrypted creds unrecoverable
# (boot fails loud, by design). dev and prod get their own keys. Generate with:
#   openssl rand -hex 32
PUSH_HUB_CRED_KEY=

# Test-only: a Postgres reachable for the DB test suites. Export it: vitest doesn't read this file
# (CLAUDE.md § Local checks). The vitest globalSetup migrates this DB before tests run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5435/pushhub_test
